# Copy to .env locally. Never commit the populated .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SasaPay Developer Portal > Sandbox Apps credentials (never paste secrets into chat)
SASAPAY_CLIENT_ID=replace-with-sandbox-client-id
SASAPAY_CLIENT_SECRET=replace-with-sandbox-client-secret
SASAPAY_MERCHANT_CODE=replace-with-sandbox-merchant-code
# SasaPay callback HMAC secret defaults to SASAPAY_CLIENT_ID per their docs.
# Override only if SasaPay gives your app a separate callback-signing secret.
SASAPAY_CALLBACK_SECRET=
# Must be a publicly reachable HTTPS URL that forwards POSTs to /webhooks/sasapay/
SASAPAY_CALLBACK_URL=https://your-public-host.example/webhooks/sasapay/
SASAPAY_API_BASE=https://sandbox.sasapay.app
STOREFRONT_CURRENCY=kes
